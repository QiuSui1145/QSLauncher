<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Defaults. ThemeService replaces these brushes at runtime. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0F14" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#121A23" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#18232E" />
    <SolidColorBrush x:Key="GlassBrush" Color="#B8121A23" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#E618232E" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="CardBrush" Color="#C418232E" />
    <SolidColorBrush x:Key="FlyoutBrush" Color="#E618232E" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="FlyoutItemHoverBrush" Color="#2A4ADE80" />
    <SolidColorBrush x:Key="ButtonGlassBrush" Color="#B818232E" />
    <SolidColorBrush x:Key="ButtonGlassHoverBrush" Color="#D218232E" />
    <SolidColorBrush x:Key="ButtonGlassBorderBrush" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#960B0F14" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#B40B0F14" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F6F8" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B7C3" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6F808E" />
    <SolidColorBrush x:Key="DividerBrush" Color="#2A3A48" />
    <SolidColorBrush x:Key="InputBrush" Color="#0D141B" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3A4D5D" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1A2530" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#384ADE80" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6EE79D" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#35C56B" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#304ADE80" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#08120C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF6B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F5B942" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#4ADE80" />
        <GradientStop Offset="0.55" Color="#20B486" />
        <GradientStop Offset="1" Color="#0F766E" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SubtlePanelGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#03FFFFFF" />
    </LinearGradientBrush>

    <sys:Double x:Key="ButtonNoiseOpacity">0.22</sys:Double>
    <sys:Double x:Key="PanelNoiseOpacity">0.55</sys:Double>
    <sys:Double x:Key="FlyoutNoiseOpacity">0.50</sys:Double>
    <sys:Double x:Key="ComboNoiseOpacity">0.42</sys:Double>

    <DrawingBrush x:Key="NoiseBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#08FFFFFF" Geometry="M0,0 L1,0 1,1 0,1 Z" />
                <GeometryDrawing Brush="#05FFFFFF" Geometry="M2,2 L3,2 3,3 2,3 Z" />
                <GeometryDrawing Brush="#04000000" Geometry="M4,0 L5,0 5,1 4,1 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="2" Direction="270"
                      Color="#000000" Opacity="0.32" RenderingBias="Performance" />
    <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="36" ShadowDepth="8" Direction="270"
                      Color="#000000" Opacity="0.45" RenderingBias="Performance" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="H1Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="41" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="H2Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="30" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="H3Text" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyMutedText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>

    <Style x:Key="CaptionText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="LabelText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,0,7" />
    </Style>

    <Style x:Key="MonoText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

</ResourceDictionary>
