<UserControl x:Class="QSLauncher.App.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SectionHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PackListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Card" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="11">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PackList" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PackListItem}" />
        </Style>

        <Style x:Key="VersionListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Row" CornerRadius="7" Padding="8,7"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VersionList" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionListItem}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="MODPACKS" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="整合包" Style="{StaticResource H1Text}" FontSize="31" Margin="0,6,0,0" />
                    <TextBlock Text="从 Modrinth 安装，或导入 ZIP / MRPACK。把整合包拖到窗口上，会直接覆盖到当前实例的挂载目录。"
                               Style="{StaticResource BodyMutedText}" FontSize="13"
                               Margin="0,10,0,0" LineHeight="21" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Border Style="{StaticResource Pill}" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding Status}" FontSize="10.5" MaxWidth="300"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Search / import -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource ModernTextBox}" Height="38" Padding="13,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="搜索 Modrinth 整合包，例如 Create、RPG、优化"
                               Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Content="搜索" Style="{StaticResource PrimaryButton}" Height="30"
                            Padding="16,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Command="{Binding SearchCommand}" />
                </Grid>
                <Button Grid.Column="1" Content="导入 ZIP / MRPACK" Style="{StaticResource SecondaryButton}"
                        Height="38" Padding="16,0" Command="{Binding ImportCommand}"
                        ToolTip="支持 CurseForge、Modrinth、Prism 与普通 ZIP 整合包" />
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Results -->
                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="发现整合包" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="来自 Modrinth 官方 API，按相关度排序。" Style="{StaticResource SectionHint}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" ToolTip="刷新">
                                <Path Data="{StaticResource IconRefresh}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                        <ListBox Style="{StaticResource PackList}" ItemsSource="{Binding Results}"
                                 SelectedItem="{Binding SelectedPack, Mode=TwoWay}" Height="510">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="46" Height="46" CornerRadius="10" ClipToBounds="True"
                                                Background="{DynamicResource InputBrush}" VerticalAlignment="Top">
                                            <Grid>
                                                <Path Data="{StaticResource IconPackage}" Width="18" Height="18"
                                                      Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border CornerRadius="10">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding IconSource}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,100,0" />
                                                <TextBlock Text="{Binding DownloadsText}" Style="{StaticResource CaptionText}"
                                                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Author}" Style="{StaticResource CaptionText}"
                                                       FontSize="9" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMutedText}"
                                                       FontSize="10.5" TextWrapping="Wrap" MaxHeight="32"
                                                       TextTrimming="CharacterEllipsis" Margin="0,5,0,0" LineHeight="16" />
                                            <TextBlock Text="{Binding Tags}" Style="{StaticResource CaptionText}"
                                                       FontSize="8.5" Margin="0,5,0,0" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ContentControl>

                <!-- Detail -->
                <StackPanel Grid.Column="1">
                    <ContentControl Style="{StaticResource FrostedPanel}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="52" Height="52" CornerRadius="11" ClipToBounds="True"
                                        Background="{DynamicResource InputBrush}">
                                    <Grid>
                                        <Path Data="{StaticResource IconPackage}" Width="20" Height="20"
                                              Stretch="Uniform" Fill="{DynamicResource TextTertiaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border CornerRadius="11">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding SelectedPack.IconSource}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" Width="235">
                                    <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource SectionTitle}"
                                               FontSize="16" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedAuthor}" Style="{StaticResource CaptionText}"
                                               FontSize="9" Margin="0,3,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedDescription}" Style="{StaticResource BodyMutedText}"
                                       FontSize="10.5" TextWrapping="Wrap" LineHeight="17" Margin="0,12,0,0"
                                       MaxHeight="70" TextTrimming="CharacterEllipsis" />

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13,0,10" />

                            <Grid>
                                <TextBlock Text="可用版本" Style="{StaticResource SectionTitle}" FontSize="13" />
                                <TextBlock Text="{Binding SelectedDownloads}" Style="{StaticResource CaptionText}"
                                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <ListBox Style="{StaticResource VersionList}" ItemsSource="{Binding Versions}"
                                     SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                     Height="150" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Loaders}" Style="{StaticResource CaptionText}"
                                                           FontSize="8.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameVersions}" Style="{StaticResource CaptionText}"
                                                           FontSize="8.5" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                           FontSize="8" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{Binding SelectedVersionText}" Style="{StaticResource CaptionText}"
                                       FontSize="8.5" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />

                            <Button Content="安装整合包" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}"
                                    HorizontalAlignment="Stretch" Height="38" Margin="0,12,0,0" />

                            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                               FontSize="9" MaxWidth="220" HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                               Style="{StaticResource CaptionText}" FontSize="9"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,6,0,0"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Background="{DynamicResource DividerBrush}"
                                             Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                            </StackPanel>

                            <Button Content="打开已安装实例" Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenFolderCommand}" Height="32" Margin="0,8,0,0"
                                    Visibility="{Binding HasInstalledPath, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="安装流水线" Style="{StaticResource SectionTitle}" FontSize="13" />
                            <TextBlock Text="每一步都可回滚；文件按 SHA-1 / SHA-512 校验。"
                                       Style="{StaticResource SectionHint}" />
                            <StackPanel Margin="0,11,0,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentSoftBrush}" Width="20" Height="20"
                                            CornerRadius="10" VerticalAlignment="Top">
                                        <TextBlock Text="1" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="原版与运行时" FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="客户端、依赖库、资源索引" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentSoftBrush}" Width="20" Height="20"
                                            CornerRadius="10" VerticalAlignment="Top">
                                        <TextBlock Text="2" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="加载器" FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="Fabric / Quilt 自动安装" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentSoftBrush}" Width="20" Height="20"
                                            CornerRadius="10" VerticalAlignment="Top">
                                        <TextBlock Text="3" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="整合包文件" FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="模组、配置、资源包" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource AccentSoftBrush}" Width="20" Height="20"
                                            CornerRadius="10" VerticalAlignment="Top">
                                        <TextBlock Text="4" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                        <TextBlock Text="覆盖层" FontSize="10.5" FontWeight="SemiBold" />
                                        <TextBlock Text="overrides 安全展开" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
