<UserControl x:Class="QSLauncher.App.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="{x:Type TabPanel}">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="PasswordInput" TargetType="{x:Type PasswordBox}">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="ACCOUNT" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="账户与登录" Style="{StaticResource H1Text}" FontSize="31"
                               Margin="0,6,0,0" />
                    <TextBlock Text="离线、皮肤站与微软正版账户都可以在这里管理；启动时使用当前选中的账户。"
                               Style="{StaticResource BodyMutedText}" FontSize="12.5" Margin="0,10,20,0"
                               LineHeight="20" MaxWidth="760" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="12,7" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" FontSize="10" MaxWidth="330"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="326" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,16,0"
                                VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="本机账户" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="令牌使用 Windows DPAPI 加密，仅当前 Windows 用户可解密。"
                                   Style="{StaticResource Hint}" Margin="0,4,0,10" />

                        <ItemsControl ItemsSource="{Binding Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,9"
                                            Margin="0,0,0,7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14"
                                                    Background="{DynamicResource InputBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="12"
                                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,4,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                           FontSize="8.5" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="使用" Style="{StaticResource GhostButton}"
                                                        Padding="6,3" FontSize="8.5" Height="24"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVisibility}}"
                                                        Command="{Binding DataContext.SelectAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        ToolTip="移除账户"
                                                        Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                                          StrokeThickness="1.5" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="10,8"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="当前账户" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                <TextBlock Text="{Binding CurrentAccountText}" FontSize="10.5"
                                           FontWeight="SemiBold" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Column="1" Style="{StaticResource FrostedPanel}"
                                VerticalAlignment="Top">
                    <StackPanel>
                        <TabControl>
                            <TabItem Header="离线账户">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="本地用户" Style="{StaticResource SectionTitle}" FontSize="12" />
                                    <TextBlock Text="离线账户只在本机生成 UUID，不连接任何认证服务器；适合单人、局域网与测试。"
                                               Style="{StaticResource Hint}" Margin="0,4,0,9" />
                                    <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0"
                                             VerticalContentAlignment="Center" />
                                    <Button Content="添加并使用" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" Height="36" Padding="20,0"
                                            Margin="0,11,0,0"
                                            Command="{Binding AddOfflineCommand}" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="皮肤站 / Yggdrasil">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="服务器地址" Style="{StaticResource SectionTitle}" FontSize="12" />
                                    <TextBox Text="{Binding YggdrasilServer, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0" Margin="0,7,0,0"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="LittleSkin 默认：https://littleskin.cn/api/yggdrasil；也支持其他 authlib-injector 服务。"
                                               Style="{StaticResource Hint}" Margin="0,4,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="邮箱 / 用户名" Style="{StaticResource CaptionText}"
                                                       FontSize="9" />
                                            <TextBox Text="{Binding YggdrasilUser, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" Height="36" Padding="12,0" Margin="0,4,0,0"
                                                     VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="密码" Style="{StaticResource CaptionText}" FontSize="9" />
                                            <PasswordBox x:Name="YggPasswordBox"
                                                         Style="{StaticResource PasswordInput}" Height="36"
                                                         Margin="0,4,0,0" Padding="12,0"
                                                         VerticalContentAlignment="Center"
                                                         PasswordChanged="OnYggPasswordChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="登录皮肤站" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" Height="36" Padding="20,0"
                                            Margin="0,12,0,0"
                                            Command="{Binding LoginYggdrasilCommand}" />
                                    <TextBlock Text="账号有多个角色时，登录后会弹出角色选择。"
                                               Style="{StaticResource Hint}" Margin="0,7,0,0" />
                                </StackPanel>
                            </TabItem>

                            <TabItem Header="微软正版">
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="点击登录后会自动打开微软官方页面，登录完成会回到启动器。"
                                               Style="{StaticResource Hint}" Margin="0,0,0,10" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="使用 Microsoft 登录" Style="{StaticResource PrimaryButton}"
                                                Height="36" Padding="20,0"
                                                Command="{Binding StartMicrosoftCommand}" />
                                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                                Height="34" Margin="8,0,0,0"
                                                Command="{Binding CancelMicrosoftCommand}" />
                                    </StackPanel>

                                    <Expander Header="Azure 应用 ID（首次使用）" Margin="0,14,0,0"
                                              Foreground="{DynamicResource TextSecondaryBrush}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernTextBox}" Height="36"
                                                     Padding="12,0" VerticalContentAlignment="Center" />
                                            <TextBlock Text="在 Azure 应用注册中创建“移动和桌面应用”，启用公共客户端流并允许 http://localhost 回调。"
                                                       Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                            <Button Content="打开 Azure 应用注册" Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Left" Height="30" Padding="10,0"
                                                    Margin="0,8,0,0" Click="OnOpenAzureClick" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="{Binding MicrosoftStatus}" Style="{StaticResource Hint}"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </TabItem>
                        </TabControl>

                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,16,0,0">
                            <ProgressBar Height="4" IsIndeterminate="True"
                                         Background="{DynamicResource DividerBrush}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                            <TextBlock Text="正在等待认证服务器…" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

