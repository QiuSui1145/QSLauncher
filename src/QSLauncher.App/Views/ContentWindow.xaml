<Window x:Class="QSLauncher.App.Views.ContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="实例内容"
        Width="600" Height="650"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="{DynamicResource BodyFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <Style x:Key="PillRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Root" Background="{DynamicResource GlassStrongBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Background" Value="{DynamicResource GlassStrongBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style x:Key="RowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="ToolTip" Value="移入隔离区" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="24,20,24,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="INSTANCE CONTENT" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="实例内容" FontFamily="{DynamicResource DisplayFont}"
                               FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding InstanceText}" FontSize="9.5"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Style="{StaticResource WindowControlButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCloseClick" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Width="11" Height="11" Stretch="Uniform" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                <RadioButton Style="{StaticResource PillRadio}" Content="资源包" GroupName="ContentKind"
                             IsChecked="{Binding IsResourcePacks, Mode=OneWay}"
                             Command="{Binding SelectKindCommand}" CommandParameter="ResourcePacks" />
                <RadioButton Style="{StaticResource PillRadio}" Content="光影包" GroupName="ContentKind"
                             Margin="8,0,0,0"
                             IsChecked="{Binding IsShaderPacks, Mode=OneWay}"
                             Command="{Binding SelectKindCommand}" CommandParameter="ShaderPacks" />
                <RadioButton Style="{StaticResource PillRadio}" Content="存档" GroupName="ContentKind"
                             Margin="8,0,0,0"
                             IsChecked="{Binding IsSaves, Mode=OneWay}"
                             Command="{Binding SelectKindCommand}" CommandParameter="Saves" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,14,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding KindTitle}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding KindHint}" FontSize="9"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"
                               Margin="0,2,0,0" MaxWidth="330" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource MiniButton}" Content="导入" Command="{Binding ImportCommand}" />
                    <Button Style="{StaticResource MiniButton}" Content="备份存档" Margin="6,0,0,0"
                            Visibility="{Binding IsSaves, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding BackupCommand}" />
                    <Button Style="{StaticResource MiniButton}" Content="打开目录" Margin="6,0,0,0"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource AccentSoftBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="ZIP" FontSize="8" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="8.5"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding SizeText}" FontSize="9"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ModifiedText}" FontSize="8"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Margin="0,0,6,0"
                                            Style="{StaticResource MiniButton}"
                                            Height="26" Padding="10,0"
                                            Content="{Binding ToggleText}"
                                            Visibility="{Binding DataContext.IsResourcePacks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                            Command="{Binding DataContext.TogglePackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="4" Style="{StaticResource RowButton}"
                                            Content="×" FontSize="15"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding EmptyText}" FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="点击右上角“导入”，或打开目录直接放入文件。"
                                   FontSize="8.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <TextBlock Text="{Binding Status}" FontSize="8.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,110,0"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
                <Button Content="关闭" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                        Height="32" Padding="18,0" Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
