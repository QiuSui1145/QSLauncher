<Window x:Class="QSLauncher.App.Views.LaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在启动游戏"
        Width="500" Height="430"
        MinWidth="440" MinHeight="390"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="18" CornerRadius="16"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.36" Color="#000000" />
        </Border.Effect>
        <Grid Margin="22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="LAUNCH PIPELINE" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                    <TextBlock Text="正在启动游戏" Style="{StaticResource H2Text}" FontSize="24"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding InstanceName}" Style="{StaticResource CaptionText}"
                               FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCloseClick" ToolTip="关闭"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}">
                    <Path Data="{StaticResource IconClose}" Width="12" Height="12"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource InputBrush}" CornerRadius="9"
                    Padding="12,9" Margin="0,14,0,0">
                <TextBlock Text="{Binding Status}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Stages}" Margin="0,15,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Marker}" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="9,1,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                           FontSize="9" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="10,8"
                        Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Failure}" FontSize="9.5"
                               Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </Border>
                <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource InputBrush}"
                             Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="查看日志" Style="{StaticResource GhostButton}" Height="30"
                            Padding="12,0" FontSize="10" Click="OnOpenLogsClick" />
                    <Button Content="关闭" Style="{StaticResource SecondaryButton}" Height="30"
                            Padding="14,0" FontSize="10" Margin="6,0,0,0"
                            Click="OnCloseClick"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
