<Window x:Class="QSLauncher.App.Views.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择文件"
        Width="1120" Height="640"
        MinWidth="860" MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.34" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}">
                        <Path Data="{StaticResource IconFolderOpen}" Width="15" Height="15"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="14" FontWeight="SemiBold" Text="选择文件" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="OnCancelClick" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Width="13" Height="13"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="18,0,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Click="OnUpClick" ToolTip="上一级">
                    <Path Data="{StaticResource IconChevronLeft}" Width="14" Height="14"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stretch="Uniform" />
                </Button>
                <Border Grid.Column="1" Margin="8,0" Height="32" CornerRadius="8"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                    <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0"
                             Padding="10,0" VerticalContentAlignment="Center" FontSize="10.5"
                             AutomationProperties.AutomationId="FilePathBox"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             KeyDown="OnPathKeyDown" />
                </Border>
                <Button Grid.Column="2" Content="转到" Style="{StaticResource GhostButton}"
                        Height="32" Padding="14,0" FontSize="10" Click="OnGoClick" />
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="186" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="10" Margin="0,0,12,0"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="快速位置" Margin="12,11,12,6" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <ListBox x:Name="PlaceList" Grid.Row="1" Background="Transparent"
                                 BorderThickness="0" Margin="5,0,5,6"
                                 SelectionChanged="OnPlaceSelected">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="Padding" Value="8,7" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border x:Name="Root" Background="Transparent" CornerRadius="7"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="Background"
                                                                Value="{DynamicResource NavHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Root" Property="Background"
                                                                Value="{DynamicResource SelectionBrush}" />
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource TextPrimaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Width="13" Height="13"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                              StrokeThickness="1.5" Stretch="Uniform"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="7,0,0,0" FontSize="10.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" CornerRadius="10"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                    <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
                             Margin="5" MouseDoubleClick="OnEntryDoubleClick"
                             AutomationProperties.AutomationId="FileEntryList"
                             SelectionChanged="OnEntrySelected">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="8,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="Root" Background="Transparent" CornerRadius="7"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource NavHoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="Background"
                                                            Value="{DynamicResource SelectionBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" CornerRadius="6"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding Glyph}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,10,0"
                                               FontSize="10.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="9"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Column="2" CornerRadius="10" Margin="12,0,0,0"
                        Background="{DynamicResource InputBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="图片预览" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Grid.Row="1" Margin="0,9,0,7" CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="PreviewHint" Text="选择图片文件后在此预览"
                                           Style="{StaticResource CaptionText}"
                                           FontSize="9" TextWrapping="Wrap" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="14" />
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6"
                                       AutomationProperties.AutomationId="FilePreviewImage" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PreviewCaption" Grid.Row="2" Style="{StaticResource CaptionText}"
                                   FontSize="8.5" TextWrapping="Wrap" TextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="18,8,18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NameLabel" Text="文件名" VerticalAlignment="Center"
                           FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBox x:Name="FileNameBox" Grid.Column="1" Margin="9,0,14,0" Height="32"
                         Style="{StaticResource ModernTextBox}"
                         VerticalContentAlignment="Center" Padding="10,0" FontSize="10.5"
                         AutomationProperties.AutomationId="FileNameBox"
                         TextChanged="OnFileNameChanged"
                         KeyDown="OnFileNameKeyDown" />
                <TextBlock x:Name="FolderHint" Grid.Column="1" Margin="9,0,14,0" VerticalAlignment="Center"
                           Text="将当前文件夹作为游戏加载目录" FontSize="10"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="Collapsed" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="取消" Style="{StaticResource GhostButton}" Height="32"
                            Padding="16,0" FontSize="10.5" Click="OnCancelClick" />
                    <Button x:Name="PrimaryButton" Content="选择文件" Style="{StaticResource PrimaryButton}"
                            Height="32" Padding="18,0" FontSize="10.5" Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
