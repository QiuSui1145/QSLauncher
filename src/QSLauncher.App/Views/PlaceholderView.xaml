<UserControl x:Class="QSLauncher.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="980"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="{Binding Eyebrow}" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1Text}"
                               FontSize="31" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMutedText}"
                               FontSize="13" MaxWidth="640" Margin="0,10,0,0" LineHeight="21"
                               HorizontalAlignment="Left" />
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource GlassBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="18,14"
                        MinWidth="112">
                    <StackPanel>
                        <TextBlock Text="下一阶段" Style="{StaticResource CaptionText}" FontSize="10" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Milestone}" FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}"
                                     VerticalAlignment="Bottom" Margin="7,0,0,7" />
                        </StackPanel>
                        <TextBlock Text="按里程碑接入" Style="{StaticResource CaptionText}" FontSize="9.5" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource GlassCard}" Padding="26" CornerRadius="18">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Pill}" Padding="9,4"
                                    Visibility="{Binding IsPriority, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconSparkle}" Fill="{DynamicResource AccentBrush}"
                                          Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                                    <TextBlock Text="第一优先级" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Padding="9,4"
                                    Background="{DynamicResource NavHoverBrush}"
                                    Visibility="{Binding IsPriority, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="模块规划" FontSize="9.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Text="{Binding MilestoneLabel}" Style="{StaticResource CaptionText}"
                                       FontSize="10" VerticalAlignment="Center" Margin="11,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="SCOPE" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}" FontSize="9" />
                    </Grid>

                    <TextBlock Text="这一模块包含" Style="{StaticResource H3Text}" Margin="0,22,0,14" />

                    <ItemsControl ItemsSource="{Binding Features}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="25" Height="25" CornerRadius="8"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            VerticalAlignment="Top" Margin="0,1,0,0">
                                        <Path Data="{StaticResource IconCheck}"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Width="12" Height="12" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13.5"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource BodyMutedText}"
                                                   FontSize="11.5" LineHeight="18" Margin="0,3,0,0"
                                                   MaxWidth="770" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,8,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Status}" FontSize="11.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource GhostButton}"
                                    Command="{Binding BackHomeCommand}"
                                    HorizontalAlignment="Right" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconChevronLeft}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="返回首页" FontSize="11" Margin="4,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource TextTertiaryBrush}"
                          StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"
                          VerticalAlignment="Center" />
                    <TextBlock Text="当前版本先交付可运行的工作台与外观系统，功能模块会按里程碑顺序替换这里的规划内容。"
                               Style="{StaticResource CaptionText}" FontSize="10.5" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
