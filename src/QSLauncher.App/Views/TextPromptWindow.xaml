<Window x:Class="QSLauncher.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入名称"
        Width="440" Height="230"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="16" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.34" Color="#000000" />
        </Border.Effect>
        <Grid Margin="20,17">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="OnHeaderMouseDown">
                <TextBlock x:Name="TitleText" Text="输入名称" Style="{StaticResource H2Text}"
                           FontSize="20" />
                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Width="11" Height="11"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                </Button>
            </Grid>

            <TextBlock x:Name="PromptText" Grid.Row="1" Style="{StaticResource CaptionText}"
                       FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />

            <Border Grid.Row="2" Height="36" CornerRadius="8" Margin="0,12,0,0"
                    Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                <TextBox x:Name="ValueBox" Background="Transparent" BorderThickness="0"
                         Padding="10,0" VerticalContentAlignment="Center" FontSize="11"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         KeyDown="OnValueKeyDown" />
            </Border>

            <TextBlock x:Name="ErrorText" Grid.Row="3" FontSize="9.5" Margin="0,8,0,0"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource GhostButton}" Height="32"
                        Padding="16,0" FontSize="10.5" Click="OnCancelClick" />
                <Button Content="确定" Style="{StaticResource PrimaryButton}" Height="32"
                        Padding="18,0" FontSize="10.5" Margin="8,0,0,0" Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
