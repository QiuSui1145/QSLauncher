<UserControl x:Class="QSLauncher.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1100"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="LAUNCH LOGS" Style="{StaticResource CaptionText}"
                           Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                <TextBlock Text="启动日志" Style="{StaticResource H1Text}" FontSize="30" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Logs.InstanceName}" Style="{StaticResource CaptionText}"
                           FontSize="10.5" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="打开日志目录" Style="{StaticResource GhostButton}" Height="32"
                        Padding="12,0" Command="{Binding OpenFolderCommand}" />
                <Button Content="清空显示" Style="{StaticResource GhostButton}" Height="32"
                        Padding="12,0" Margin="6,0,0,0" Command="{Binding ClearCommand}" />
                <Button Content="导出完整日志 ZIP" Style="{StaticResource PrimaryButton}" Height="34"
                        Padding="15,0" Margin="7,0,0,0" Command="{Binding ExportCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="实时输出" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="{Binding Logs.CurrentLogText}" Style="{StaticResource CaptionText}"
                                       FontSize="8.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="620" />
                        </StackPanel>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="9,4"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Logs.Lines.Count}" FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource InputBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="0,12,0,10" MinHeight="260">
                        <ListBox x:Name="LogList" ItemsSource="{Binding Logs.Lines}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{DynamicResource MonoFont}"
                                                   FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,1,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding EmptyHint}"
                               Style="{StaticResource CaptionText}" FontSize="10.5"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="30,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Logs.HasLines, Converter={StaticResource InverseBoolToVisibility}}" />

                    <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource CaptionText}"
                               FontSize="9.5" TextWrapping="Wrap" />
                </Grid>
            </ContentControl>

            <StackPanel Grid.Column="1">
                <ContentControl Style="{StaticResource FrostedPanel}">
                    <StackPanel>
                        <TextBlock Text="简易纠错" Style="{StaticResource SectionTitle}" FontSize="15" />
                        <TextBlock Text="{Binding Logs.FindingSummary}" Style="{StaticResource CaptionText}"
                                   FontSize="9.5" Margin="0,4,0,0" />
                        <TextBlock Text="没有发现问题。" Style="{StaticResource CaptionText}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Visibility="{Binding Logs.HasFindings, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding Logs.Findings}" Margin="0,9,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="10,9"
                                            Margin="0,0,0,7">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                       FontSize="9.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Suggestion}" FontSize="9.5"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding ModName, StringFormat=相关模组：{0}}"
                                                       Style="{StaticResource CaptionText}" FontSize="9"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding ModName, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="启动流程" Style="{StaticResource SectionTitle}" FontSize="14" />
                        <ItemsControl ItemsSource="{Binding Logs.Stages}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Marker}" FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="10.5" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                       FontSize="8.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
