<Window x:Class="QSLauncher.App.Views.CharacterSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择角色"
        Width="420" Height="430"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="14" Background="{DynamicResource GlassStrongBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" Margin="22,18,16,8" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="YGGDRASIL" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                    <TextBlock Text="选择角色" Style="{StaticResource H2Text}" FontSize="23"
                               Margin="0,4,0,0" />
                    <TextBlock Text="该账号有多个角色，选择本次进入游戏使用的角色。"
                               Style="{StaticResource CaptionText}" FontSize="9" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="22,4,22,4" Background="{DynamicResource InputBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="6">
                <ListBox x:Name="CharacterList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnListDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                                Padding="10,9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="8"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Id}" FontSize="8"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background"
                                                        Value="{DynamicResource NavHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Grid Grid.Row="2" Margin="22,10,22,18">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Height="34"
                        Padding="18,0" HorizontalAlignment="Right" Margin="0,0,88,0"
                        Click="OnCancelClick" />
                <Button Content="使用此角色" Style="{StaticResource PrimaryButton}" Height="34"
                        Padding="18,0" HorizontalAlignment="Right" Click="OnConfirmClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
