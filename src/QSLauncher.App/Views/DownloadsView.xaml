<UserControl x:Class="QSLauncher.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="VersionListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionList" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource VersionListItem}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180" DataContext="{Binding Core}">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="DOWNLOAD" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="下载游戏与加载器" Style="{StaticResource H1Text}"
                               FontSize="30" Margin="0,6,0,0" />
                    <TextBlock Text="Mojang 官方清单；安装完成后会出现在版本管理页。"
                               Style="{StaticResource BodyMutedText}" FontSize="12.5" Margin="0,9,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Pill}" Padding="12,7" HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{Binding Status}" FontSize="10.5" VerticalAlignment="Center"
                                   MaxWidth="300" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="官方版本" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Mojang version_manifest_v2" Style="{StaticResource SectionHint}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    Command="{Binding RefreshCommand}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" ToolTip="刷新版本清单">
                                <Path Data="{StaticResource IconRefresh}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="12,0" />
                            <TextBlock Text="搜索版本号，例如 26.3" Margin="13,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,10,0,4">
                            <TextBlock Text="{Binding Versions.Count, StringFormat={}{0} 个版本}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource SwitchToggle}"
                                      IsChecked="{Binding ShowSnapshots, Mode=TwoWay}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Text="显示快照" Style="{StaticResource CaptionText}"
                                       HorizontalAlignment="Right" Margin="0,0,42,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,4,0,6" />
                        <ListBox Style="{StaticResource VersionList}" ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" Height="430">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,8" ToolTip="{Binding Id}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Id}" FontSize="12.5" FontWeight="SemiBold" />
                                                <Border Background="{DynamicResource InputBrush}" CornerRadius="4"
                                                        Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="8.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}"
                                                       FontSize="9.5" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding InstallLabel}"
                                                   Style="{StaticResource CaptionText}" FontSize="9.5"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ContentControl>

                <StackPanel Grid.Column="1">
                    <ContentControl Style="{StaticResource FrostedPanel}">
                        <StackPanel>
                            <TextBlock Text="所选版本" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="{Binding SelectedVersionTitle}" Style="{StaticResource H2Text}"
                                       FontSize="22" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedVersionMeta}" Style="{StaticResource CaptionText}"
                                       FontSize="10" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding SelectedVersionHint}" Style="{StaticResource BodyMutedText}"
                                       FontSize="11" TextWrapping="Wrap" LineHeight="18" Margin="0,10,0,0" />
                            <Button Content="{Binding InstallActionLabel}" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding InstallCommand}" IsEnabled="{Binding HasSelectedVersion}"
                                    HorizontalAlignment="Stretch" Margin="0,14,0,0" Height="38" />
                            <Button Content="安装模组加载器"
                                    AutomationProperties.AutomationId="OpenLoaderButton"
                                    Style="{StaticResource SecondaryButton}" Command="{Binding OpenLoaderCommand}"
                                    IsEnabled="{Binding HasSelectedVersion}" HorizontalAlignment="Stretch"
                                    Margin="0,7,0,0" Height="34" FontSize="10.5" />
                            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,13,0,0">
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                           FontSize="9.5" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="4" Minimum="0" Maximum="100"
                                             Value="{Binding Progress, Mode=OneWay}" Margin="0,6,0,0"
                                             Background="{DynamicResource DividerBrush}"
                                             Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="安装后" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="每个版本会生成独立实例，使用单独的 game 目录；可安装 Fabric、Forge、NeoForge 或 Quilt。"
                                       Style="{StaticResource SectionHint}" FontSize="10" />
                            <Button Content="前往版本管理" Style="{StaticResource GhostButton}"
                                    Height="32" Margin="0,10,0,0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="Versions" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
