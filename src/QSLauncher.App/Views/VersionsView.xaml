<UserControl x:Class="QSLauncher.App.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="InstanceListItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="LOCAL VERSIONS" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="版本管理" Style="{StaticResource H1Text}" FontSize="30"
                               Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsManagedRoot, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="强制版本隔离" FontSize="9.5"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="每个实例拥有自己的 mods、config、saves 与 Java 设置。"
                                   Style="{StaticResource CaptionText}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsExternalRoot, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="5" Padding="7,3">
                            <TextBlock Text="目录直读" FontSize="9.5"
                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="版本、模组与存档直接使用当前加载目录，不会复制或导入文件。"
                                   Style="{StaticResource CaptionText}" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ComboBox ItemsSource="{Binding MountModes}" SelectedItem="{Binding SelectedMountMode, Mode=TwoWay}"
                              Width="132" Height="32" FontSize="10"
                              VerticalContentAlignment="Center"
                              Background="{DynamicResource InputBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}"
                              ToolTip="单目录：一次只挂载一个；多目录：同时挂载所有目录">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="10" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Height="32"
                            Padding="12,0" Margin="7,0,0,0" Command="{Binding RefreshCommand}" />
                    <Button Content="下载新版本" Style="{StaticResource PrimaryButton}" Height="34"
                            Padding="16,0" Margin="7,0,0,0"
                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="Downloads" />
                </StackPanel>
            </Grid>

            <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,0,0,14"
                            Visibility="{Binding IsSingleMount, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="游戏加载目录" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ExternalRootLabel}" Style="{StaticResource CaptionText}"
                                   FontSize="8.5" MaxWidth="210" TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RootOptions}"
                              SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                              Height="32" VerticalContentAlignment="Center" FontSize="10.5"
                              Background="{DynamicResource InputBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource InputBorderBrush}"
                              ToolTip="切换 Minecraft 加载目录，直接读取其中的版本">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Display}" FontSize="10.5" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                               FontSize="8.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                        <Button Content="刷新" Style="{StaticResource GhostButton}" Height="32" Padding="10,0"
                                FontSize="10" Command="{Binding ScanRootCommand}" />
                        <Button Content="添加目录" Style="{StaticResource SecondaryButton}" Height="32"
                                Padding="10,0" FontSize="10" Margin="6,0,0,0"
                                Command="{Binding AddRootCommand}" />
                        <Button Content="重命名" Style="{StaticResource GhostButton}" Height="32"
                                Padding="9,0" FontSize="10" Margin="6,0,0,0"
                                Visibility="{Binding IsExternalRoot, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding RenameRootCommand}"
                                CommandParameter="{Binding SelectedRoot}" />
                        <Button Content="移除" Style="{StaticResource GhostButton}" Height="32"
                                Padding="9,0" FontSize="10" Margin="6,0,0,0"
                                Visibility="{Binding IsExternalRoot, Converter={StaticResource BoolToVisibility}}"
                                Command="{Binding RemoveRootCommand}"
                                CommandParameter="{Binding SelectedRoot}" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,0,0,14"
                            Visibility="{Binding IsMultipleMount, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="同时挂载的目录" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding RootCountText}" Style="{StaticResource CaptionText}"
                                       FontSize="9" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="添加游戏目录" Style="{StaticResource PrimaryButton}" Height="32"
                                Padding="14,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Command="{Binding AddRootCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Roots}" Margin="0,10,0,0"
                                  Visibility="{Binding HasRoots, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="12,9"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}"
                                                       FontSize="8.5" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Content="重命名" Style="{StaticResource GhostButton}"
                                                    Height="28" Padding="9,0" FontSize="9.5"
                                                    Command="{Binding DataContext.RenameRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="移除" Style="{StaticResource GhostButton}"
                                                    Height="28" Padding="9,0" FontSize="9.5" Margin="4,0,0,0"
                                                    Foreground="{DynamicResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveRootCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding HasRoots, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="还没有挂载目录" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="添加 .minecraft 目录并为它命名；版本会直接进入下方实例总库。"
                                   Style="{StaticResource CaptionText}" FontSize="9.5"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,0,0,14"
                            Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="该目录中的版本" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding ExternalRootLabel}" Style="{StaticResource CaptionText}"
                                       FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="5" Padding="8,4"
                                HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="{Binding ExternalVersions.Count}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,26,0,10"
                                Visibility="{Binding HasExternalVersions, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="这个目录里没有可读取的版本" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="请选择包含 versions 文件夹和版本 JSON 的 .minecraft 目录，然后点击刷新。"
                                   Style="{StaticResource CaptionText}" FontSize="10.5"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="刷新" Style="{StaticResource SecondaryButton}" Height="32"
                                    Padding="14,0" Command="{Binding ScanRootCommand}" />
                            <Button Content="更改加载目录" Style="{StaticResource PrimaryButton}" Height="32"
                                    Padding="14,0" Margin="8,0,0,0" Command="{Binding AddRootCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding ExternalVersions}" Background="Transparent"
                             BorderThickness="0" MaxHeight="430" Margin="0,10,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasExternalVersions, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="14,11"
                                        Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Id}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}"
                                                       FontSize="9" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"
                                                       FontSize="8.5" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"
                                                       Visibility="{Binding CanLaunch, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Content="启动" Style="{StaticResource SecondaryButton}"
                                                    Height="28" Padding="15,0" FontSize="10"
                                                    IsEnabled="{Binding CanLaunch}"
                                                    ToolTip="{Binding StatusText}"
                                                    Command="{Binding DataContext.PlayExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" FontSize="9.5"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </ContentControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="实例总库" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Instances.Count, StringFormat={}{0} 个实例 · 挂载版本带目录标签}"
                                           Style="{StaticResource CaptionText}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="5" Padding="8,4"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Instances.Count}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <StackPanel Visibility="{Binding HasInstances, Converter={StaticResource InverseBoolToVisibility}}"
                                    Margin="0,24,0,8">
                            <TextBlock Text="还没有本地版本" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="在下载页安装原版或整合包，完成后会出现在这里。"
                                       Style="{StaticResource CaptionText}" FontSize="10.5"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                            <Button Content="前往下载" Style="{StaticResource PrimaryButton}" Height="34"
                                    Padding="18,0" HorizontalAlignment="Center" Margin="0,14,0,0"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="Downloads" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                                 ItemContainerStyle="{StaticResource InstanceListItem}"
                                 Background="Transparent" BorderThickness="0" Height="320"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasInstances, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="13,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="4" Padding="6,2" Margin="0,0,7,3"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="8"
                                                                   MaxWidth="108" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}"
                                                               FontSize="9.5" VerticalAlignment="Center"
                                                               Margin="0,0,0,3" />
                                                </WrapPanel>
                                                <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource CaptionText}"
                                                           FontSize="9" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="启动" Style="{StaticResource PrimaryButton}"
                                                        Height="28" Padding="13,0" FontSize="10.5"
                                                        Command="{Binding DataContext.PlayInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                        Margin="5,0,0,0" ToolTip="实例设置"
                                                        Command="{Binding DataContext.EditInstanceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconSettings}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                        Margin="3,0,0,0" ToolTip="打开目录"
                                                        Command="{Binding DataContext.OpenInstanceFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconFolder}"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ContentControl>

                <StackPanel Grid.Column="1">
                    <ContentControl Style="{StaticResource FrostedPanel}">
                        <StackPanel>
                            <TextBlock Text="实例详情" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="{Binding SelectedInstance.Name, TargetNullValue=选择一个实例}"
                                       Style="{StaticResource H2Text}" FontSize="22" Margin="0,11,0,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SelectedInstance.VersionLabel}" Style="{StaticResource CaptionText}"
                                       FontSize="10" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding SelectedInstance.LastPlayedText}" Style="{StaticResource CaptionText}"
                                       FontSize="9.5" Margin="0,3,0,0" />

                            <Button Content="启动游戏" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding HasSelectedInstance}"
                                    Height="40" Margin="0,15,0,0"
                                    Command="{Binding PlayInstanceCommand}"
                                    CommandParameter="{Binding SelectedInstance}" />
                            <Button Content="实例设置与 Java" Style="{StaticResource SecondaryButton}"
                                    IsEnabled="{Binding HasSelectedInstance}"
                                    Height="34" Margin="0,7,0,0"
                                    Command="{Binding EditInstanceCommand}"
                                    CommandParameter="{Binding SelectedInstance}" />
                            <UniformGrid Columns="3" Margin="0,8,0,0">
                                <Button Content="目录" Style="{StaticResource GhostButton}" Height="30"
                                        FontSize="10" Margin="0,0,4,0"
                                        Command="{Binding OpenInstanceFolderCommand}"
                                        CommandParameter="{Binding SelectedInstance}" />
                                <Button Content="复制" Style="{StaticResource GhostButton}" Height="30"
                                        FontSize="10" Margin="2,0,2,0"
                                        Command="{Binding CopyInstanceCommand}"
                                        CommandParameter="{Binding SelectedInstance}" />
                                <Button Content="删除" Style="{StaticResource GhostButton}" Height="30"
                                        FontSize="10" Margin="4,0,0,0"
                                        Foreground="{DynamicResource DangerBrush}"
                                        Command="{Binding DeleteInstanceCommand}"
                                        CommandParameter="{Binding SelectedInstance}" />
                            </UniformGrid>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="实例内容" Style="{StaticResource SectionTitle}" FontSize="15" />
                            <TextBlock Text="模组、资源包、光影与存档都存放在该实例内，不会影响其他版本。"
                                       Style="{StaticResource CaptionText}" FontSize="10" TextWrapping="Wrap"
                                       LineHeight="16" Margin="0,5,0,10" />
                            <Button Content="管理资源" Style="{StaticResource SecondaryButton}" Height="32"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="Resources" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
