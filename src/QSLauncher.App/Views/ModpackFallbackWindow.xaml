<Window x:Class="QSLauncher.App.Views.ModpackFallbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择整合包基础版本"
        Width="430" Height="370"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border CornerRadius="14" Background="{DynamicResource GlassStrongBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
            Padding="22,18,22,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="GENERIC ZIP" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                    <TextBlock Text="选择基础版本" Style="{StaticResource H2Text}" FontSize="23"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="PackLabel" Style="{StaticResource CaptionText}"
                               FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="Minecraft 版本" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                <ComboBox x:Name="VersionBox" IsEditable="True" Height="36"
                          ItemsSource="{Binding Versions}" SelectedIndex="0" />
                <TextBlock Text="加载器" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                <ComboBox x:Name="LoaderBox" Height="36" ItemsSource="{Binding Loaders}"
                          DisplayMemberPath="Name" SelectedIndex="0" />
                <TextBlock Text="这个 ZIP 没有整合包清单，需要指定游戏版本；加载器装错可以稍后在实例设置中重装。"
                           Style="{StaticResource CaptionText}" FontSize="9"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="取消" Style="{StaticResource GhostButton}" Height="34"
                        Padding="16,0" Click="OnCancelClick" />
                <Button Content="开始导入" Style="{StaticResource PrimaryButton}" Height="34"
                        Padding="20,0" Margin="8,0,0,0" Click="OnConfirmClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
