<UserControl x:Class="QSLauncher.App.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="SectionHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MiniButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Background" Value="{DynamicResource ButtonGlassBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonGlassBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="JAVA RUNTIME" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="Java 环境" Style="{StaticResource H1Text}" FontSize="31" Margin="0,6,0,0" />
                    <TextBlock Text="复用系统 Java，或从 Mojang 官方源安装与游戏匹配的运行时。"
                               Style="{StaticResource BodyMutedText}" FontSize="13" Margin="0,10,0,0" LineHeight="21" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="12,7" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" FontSize="10.5" MaxWidth="300"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="316" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="已检测到的 Java" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding RuntimeCountText}" Style="{StaticResource SectionHint}" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    Command="{Binding ScanCommand}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" ToolTip="重新扫描">
                                <Path Data="{StaticResource IconRefresh}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12,0,8" />

                        <StackPanel Visibility="{Binding HasRuntimes, Converter={StaticResource InverseBoolToVisibility}}"
                                    Margin="0,22,0,22" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconJava}" Width="28" Height="28" Stretch="Uniform"
                                  Fill="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="没有检测到 Java" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,9,0,0" />
                            <TextBlock Text="可在右侧安装官方运行时。" Style="{StaticResource CaptionText}"
                                       FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Runtimes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="9" Padding="12,10"
                                            Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6"
                                                    Height="26" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding VersionText}" FontSize="11.5"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource InputBrush}" CornerRadius="4"
                                                            Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SourceText}" FontSize="8"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                            Padding="5,1" Margin="5,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="默认" FontSize="8" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionText}"
                                                           FontSize="8.5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="设为默认" Style="{StaticResource MiniButton}"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.SetDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <StackPanel Grid.Column="1">
                    <ContentControl Style="{StaticResource FrostedPanel}">
                        <StackPanel>
                            <TextBlock Text="安装官方运行时" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <TextBlock Text="来自 Mojang java-runtime，校验 SHA-1 后解压到便携目录。"
                                       Style="{StaticResource SectionHint}" />

                            <StackPanel Margin="0,12,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Java 8" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="旧版本与部分 Forge 整合包" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource MiniButton}"
                                            Command="{Binding InstallCommand}" CommandParameter="8" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Java 17" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="1.18 – 1.20.4" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource MiniButton}"
                                            Command="{Binding InstallCommand}" CommandParameter="17" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Java 21" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="1.20.5 – 1.21.x" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource MiniButton}"
                                            Command="{Binding InstallCommand}" CommandParameter="21" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Java 25" FontSize="11" FontWeight="SemiBold" />
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="4"
                                                    Padding="5,1" Margin="6,0,0,0">
                                                <TextBlock Text="推荐" FontSize="8" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="26.x 及更高版本" Style="{StaticResource CaptionText}" FontSize="8.5" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="安装" Style="{StaticResource PrimaryButton}"
                                            Height="26" Padding="12,0" FontSize="9.5"
                                            Command="{Binding InstallCommand}" CommandParameter="25" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                        Margin="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}"
                                               FontSize="9" MaxWidth="200" HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                               Style="{StaticResource CaptionText}" FontSize="9"
                                               HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="4" Minimum="0" Maximum="100" Margin="0,6,0,0"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Background="{DynamicResource DividerBrush}"
                                             Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                            </StackPanel>
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="默认 Java" Style="{StaticResource SectionTitle}" FontSize="14" />
                            <TextBlock Text="{Binding DefaultRuntimeText}" FontSize="11" FontWeight="SemiBold"
                                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="未固定时，启动器会按游戏版本自动选择最合适的 Java。"
                                       Style="{StaticResource CaptionText}" FontSize="9" TextWrapping="Wrap"
                                       Margin="0,5,0,0" LineHeight="15" />
                            <Button Content="打开 Java 目录" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenFolderCommand}" Height="30" Margin="0,11,0,0" />
                        </StackPanel>
                    </ContentControl>

                    <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="为什么会需要多个 Java?" Style="{StaticResource SectionTitle}" FontSize="12" />
                            <TextBlock Text="不同 Minecraft 版本编译目标不同。启动器不会修改系统 Java，而是把官方运行时放在 data\meta\java 下，随启动器一起迁移。"
                                       Style="{StaticResource CaptionText}" FontSize="9" TextWrapping="Wrap"
                                       LineHeight="16" Margin="0,7,0,0" />
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
