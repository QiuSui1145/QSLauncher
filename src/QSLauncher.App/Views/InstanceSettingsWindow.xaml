<Window x:Class="QSLauncher.App.Views.InstanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="实例设置"
        Width="560" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="FieldHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="FieldBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource GlassStrongBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderArea" Background="Transparent" Margin="22,18,16,10"
                  MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="INSTANCE PROFILE" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                    <TextBlock Text="实例设置" Style="{StaticResource H2Text}" FontSize="23"
                               Margin="0,4,0,0" />
                    <TextBlock Text="只影响当前实例；保存后下次启动生效。"
                               Style="{StaticResource CaptionText}" FontSize="9" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,4,14,0">
                <StackPanel Margin="0,0,4,6">
                    <TextBlock Text="实例名称" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" />
                    <TextBlock Text="用于在列表与日志中区分不同实例。" Style="{StaticResource FieldHint}"
                               Margin="0,-7,0,12" />

                    <TextBlock Text="游戏版本" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Height="34" Padding="10,0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionLabel}" FontSize="10" />
                            <TextBlock Text="{Binding Info.Manifest.VersionId}" Style="{StaticResource CaptionText}"
                                       FontSize="8.5" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="内存上限 (MB)" Style="{StaticResource FieldLabel}" />
                                <Button Content="智能分配" Style="{StaticResource MiniButton}"
                                        Height="22" Padding="7,0" FontSize="8"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="OnAutoMemoryClick"
                                        ToolTip="按模组、资源包与光影数量估算" />
                            </Grid>
                            <TextBox Text="{Binding MemoryMb, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource FieldBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Java 路径（可选）" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding JavaPath, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource FieldBox}" Margin="0" />
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButton}"
                                        Height="34" Padding="12,0" FontSize="10" Margin="5,0,0,0"
                                        Click="OnBrowseJavaClick" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="留空时使用全局 Java 设置；手动指定会覆盖全局选择。"
                               Style="{StaticResource FieldHint}" Margin="0,4,0,12" />
                    <TextBlock Text="智能分配会按实例内模组、资源包和光影数量估算，避免内存不足或过量占用。"
                               Style="{StaticResource FieldHint}" Margin="0,-7,0,12" />

                    <TextBlock Text="JVM 参数" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding JvmArgs, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="58" Padding="10,8"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="-Xmx 会由内存上限单独生成，无需重复填写。其它参数按空格拆分。"
                               Style="{StaticResource FieldHint}" Margin="0,-7,0,12" />

                    <TextBlock Text="游戏参数" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding GameArgs, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldBox}" Height="58" Padding="10,8"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="例如 --width 1280 --height 720，启动时追加到参数末尾。"
                               Style="{StaticResource FieldHint}" Margin="0,-7,0,4" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="22,12,22,18">
                <TextBlock Text="{Binding Info.Directory}" Style="{StaticResource CaptionText}"
                           FontSize="7.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="0,0,150,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Height="34" Padding="18,0" Click="OnCancelClick" Margin="0,0,7,0" />
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}"
                            Height="34" Padding="20,0" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
