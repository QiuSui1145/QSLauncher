<Window x:Class="QSLauncher.App.Views.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS Launcher"
        Width="460"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{DynamicResource BodyFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border Margin="18" CornerRadius="14"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.34" Color="#000000" />
        </Border.Effect>
        <Grid Margin="22,18,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}">
                        <Path Data="{StaticResource IconInfo}"
                              Width="16" Height="16"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="TitleText" Margin="11,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource DisplayFont}"
                               FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="OnCancelClick" ToolTip="关闭">
                    <Path Data="{StaticResource IconClose}" Width="13" Height="13"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,0" MaxHeight="360"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="11.5"
                           LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="SecondaryButton" Content="取消" Style="{StaticResource GhostButton}"
                        Height="32" Padding="16,0" FontSize="10.5" Click="OnCancelClick" />
                <Button x:Name="PrimaryButton" Content="确定" Style="{StaticResource PrimaryButton}"
                        Height="32" Padding="18,0" FontSize="10.5" Margin="8,0,0,0"
                        Click="OnPrimaryClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
