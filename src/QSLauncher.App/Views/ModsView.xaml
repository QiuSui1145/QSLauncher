<UserControl x:Class="QSLauncher.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1000"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="16" />
        </Style>
        <Style x:Key="MiniButton" TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="27" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Background" Value="{DynamicResource ButtonGlassBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonGlassBorderBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,8,0">
        <StackPanel MaxWidth="1180">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0">
                    <TextBlock Text="MOD WORKBENCH" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10" />
                    <TextBlock Text="模组工作台" Style="{StaticResource H1Text}" FontSize="31"
                               Margin="0,6,0,0" />
                    <TextBlock Text="围绕当前实例搜索、安装、启停与更新；只展示与游戏版本和加载器兼容的 Modrinth 项目。"
                               Style="{StaticResource BodyMutedText}" FontSize="12.5" Margin="0,9,0,0"
                               LineHeight="20" MaxWidth="720" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="12,7" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}" FontSize="10" MaxWidth="330"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <ContentControl Style="{StaticResource FrostedPanel}" Margin="0,0,0,14" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="当前实例" Style="{StaticResource CaptionText}" FontSize="9" />
                            <TextBlock Text="{Binding InstanceSummary}" FontSize="9"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Instances}"
                                  SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                  Height="44" MaxWidth="460" HorizontalAlignment="Left"
                                  MinWidth="320" Padding="10,2"
                                  Background="{DynamicResource InputBrush}"
                                  BorderBrush="{DynamicResource InputBorderBrush}"
                                  ToolTip="切换要管理模组的实例">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="380" />
                                        <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}"
                                                   FontSize="8.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"
                                Margin="10,0,0,0">
                        <Button Content="检查更新" Style="{StaticResource MiniButton}"
                                Command="{Binding CheckUpdatesCommand}" Margin="0,0,5,0" />
                        <Button Content="导入 JAR" Style="{StaticResource MiniButton}"
                                Command="{Binding ImportCommand}" Margin="0,0,5,0" />
                        <Button Content="打开模组目录" Style="{StaticResource MiniButton}"
                                Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </Grid>
            </ContentControl>

            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding IsVanilla, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="原版实例不能加载模组。请在“下载”页安装 Fabric / Quilt / Forge / NeoForge，或直接安装整合包。"
                           FontSize="10" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.02*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="0.98*" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource FrostedPanel}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="已安装" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="启用 / 停用不会删除文件；也可以直接导入本地 JAR。"
                                           Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="{Binding InstalledTotalText}"
                                       Style="{StaticResource CaptionText}" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11,0,8" />

                        <StackPanel Visibility="{Binding HasInstalledMods, Converter={StaticResource InverseBoolToVisibility}}"
                                    Margin="0,26,0,24" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconPuzzle}" Width="26" Height="26"
                                  Fill="{DynamicResource TextTertiaryBrush}" Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="这个实例还没有模组" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="从右侧 Modrinth 结果安装，或导入本地 JAR。"
                                       Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding InstalledMods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5"
                                                               FontWeight="SemiBold" MaxWidth="230"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Background="{DynamicResource InputBrush}"
                                                            CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionText}" FontSize="7.5"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding StateText}" FontSize="8"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Text=" · " FontSize="8"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="8"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="8"
                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                               Margin="6,0,0,0" MaxWidth="180"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="{Binding ToggleText}"
                                                        Style="{StaticResource MiniButton}" Height="24"
                                                        Padding="8,0" FontSize="8.5"
                                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                        Margin="2,0,0,0" ToolTip="删除模组"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Width="8" Height="8"
                                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                                          StrokeThickness="1.5" Stretch="Uniform" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,2"
                              Visibility="{Binding HasInstalledPaging, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding InstalledPageText}" Style="{StaticResource CaptionText}"
                                       FontSize="9" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="上一页" Style="{StaticResource MiniButton}"
                                        Height="24" Padding="8,0" FontSize="8.5"
                                        IsEnabled="{Binding CanInstalledPrevious}"
                                        Command="{Binding InstalledPreviousPageCommand}" />
                                <Button Content="下一页" Style="{StaticResource MiniButton}"
                                        Height="24" Padding="8,0" FontSize="8.5" Margin="5,0,0,0"
                                        IsEnabled="{Binding CanInstalledNext}"
                                        Command="{Binding InstalledNextPageCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8"
                                Padding="10,8" Margin="0,6,0,0"
                                Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="可用更新" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <ItemsControl ItemsSource="{Binding Updates}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="9.5"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                                    <TextBlock Text="{Binding VersionText}" FontSize="8.5"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               Margin="6,0,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="更新"
                                                        Style="{StaticResource MiniButton}" Height="22"
                                                        Padding="8,0" FontSize="8"
                                                        Command="{Binding DataContext.ApplyUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Column="2" Style="{StaticResource FrostedPanel}">
                    <StackPanel>
                        <TextBlock Text="发现模组" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="只显示兼容当前实例的项目，安装时自动校验文件哈希。"
                                   Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="ModSearchBox"
                                     Style="{StaticResource ModernTextBox}" Height="34" Padding="11,0"
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="搜索" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.AutomationId="ModSearchButton"
                                    Height="34" Padding="16,0" Margin="7,0,0,0"
                                    Command="{Binding SearchCommand}" />
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding GameVersions}" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedGameVersion, Mode=TwoWay}"
                                      Height="30" FontSize="10" Margin="0,0,4,0"
                                      Background="{DynamicResource InputBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="10" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Loaders}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedLoader, Mode=TwoWay}"
                                      Height="30" FontSize="10" Margin="4,0,0,0"
                                      Background="{DynamicResource InputBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderBrush="{DynamicResource InputBorderBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="10" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Categories}" Margin="0,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Style="{StaticResource SecondaryButton}"
                                            Height="23" Padding="8,0" FontSize="8.5" Margin="0,0,4,4"
                                            Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="{Binding DiscoveryTitle}" Style="{StaticResource SecondaryButton}" Height="32"
                                FontSize="10" Margin="0,2,0,0" Command="{Binding RecommendCommand}" />

                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}"
                                           FontSize="8.5" HorizontalAlignment="Left" MaxWidth="190"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                           Style="{StaticResource Hint}" FontSize="8.5"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar Height="3" Minimum="0" Maximum="100" Margin="0,5,0,0"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Background="{DynamicResource DividerBrush}"
                                         Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,11,0,8" />

                        <StackPanel Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}"
                                    Margin="0,20,0,18" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconSearch}" Width="24" Height="24"
                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4"
                                  Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="搜索 Modrinth 模组" FontSize="10.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="输入名称、功能或作者；留空可浏览热门项目。"
                                       Style="{StaticResource Hint}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26" Height="26" CornerRadius="7"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    ClipToBounds="True" VerticalAlignment="Top">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontSize="11"
                                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <Image Source="{Binding IconSource}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,6,0">
                                                <TextBlock Text="{Binding Title}" FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}"
                                                           FontSize="8.5" MaxHeight="30" Margin="0,3,0,0"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OriginalDescription}" />
                                                <TextBlock Text="{Binding DownloadsText}" FontSize="8"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="安装" Style="{StaticResource MiniButton}"
                                                    Height="25" Padding="10,0" FontSize="8.5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,8,0,0"
                              Visibility="{Binding HasResultsPaging, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ResultsPageText}" Style="{StaticResource CaptionText}"
                                       FontSize="9" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="上一页" Style="{StaticResource MiniButton}"
                                        Height="24" Padding="8,0" FontSize="8.5"
                                        IsEnabled="{Binding CanResultsPrevious}"
                                        Command="{Binding ResultsPreviousPageCommand}" />
                                <Button Content="下一页" Style="{StaticResource MiniButton}"
                                        Height="24" Padding="8,0" FontSize="8.5" Margin="5,0,0,0"
                                        IsEnabled="{Binding CanResultsNext}"
                                        Command="{Binding ResultsNextPageCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
