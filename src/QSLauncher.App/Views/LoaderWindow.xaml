<Window x:Class="QSLauncher.App.Views.LoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="安装模组加载器"
        Width="520" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LoaderPill" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Hint}" FontSize="7.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LoaderList" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VersionItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="9,6">
                            <TextBlock Text="{Binding}" FontSize="10" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource NavHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource GlassStrongBrush}"
            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.42" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" Margin="22,18,16,10" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="LOADER RUNTIME" Style="{StaticResource CaptionText}"
                               Foreground="{DynamicResource AccentBrush}" FontSize="9" />
                    <TextBlock Text="安装模组加载器" Style="{StaticResource H2Text}" FontSize="23"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding MinecraftVersion, StringFormat=为 Minecraft {0} 选择加载器与版本。}"
                               Style="{StaticResource CaptionText}" FontSize="9" Margin="0,5,0,0" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnCancelClick">
                    <Path Data="{StaticResource IconClose}" Width="9" Height="9"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          Stretch="Uniform" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,4,22,0">
                <TextBlock Text="加载器" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding SelectedLoader}"
                         ItemContainerStyle="{StaticResource LoaderPill}"
                         Style="{StaticResource LoaderList}"
                         IsEnabled="{Binding IsIdle}" />

                <Grid Margin="0,5,0,7">
                    <TextBlock Text="版本" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Status}" FontSize="8.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Right" MaxWidth="300"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="5" Height="210">
                    <ListBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                             ItemContainerStyle="{StaticResource VersionItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Border>

                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,11,0,0">
                    <Grid>
                        <TextBlock Text="{Binding ProgressText}" FontSize="8.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="8.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Height="3" Minimum="0" Maximum="100" Margin="0,5,0,0"
                                 Value="{Binding Progress, Mode=OneWay}"
                                 Background="{DynamicResource DividerBrush}"
                                 Foreground="{DynamicResource AccentBrush}" BorderThickness="0" />
                </StackPanel>

                <TextBlock Text="Forge / NeoForge 会调用官方安装器，首次安装需要下载较多依赖。"
                           Style="{StaticResource CaptionText}" FontSize="8.5" TextWrapping="Wrap"
                           Margin="0,10,0,0" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,12,22,18">
                <TextBlock Text="安装只写入便携数据目录。" FontSize="8.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,150,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}"
                            Height="34" Padding="18,0" Click="OnCancelClick" Margin="0,0,7,0" />
                    <Button Content="安装" Style="{StaticResource PrimaryButton}"
                            Height="34" Padding="24,0"
                            Command="{Binding InstallCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
