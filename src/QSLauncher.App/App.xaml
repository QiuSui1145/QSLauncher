<Application x:Class="QSLauncher.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QSLauncher.App.ViewModels"
             xmlns:views="clr-namespace:QSLauncher.App.Views"
             xmlns:conv="clr-namespace:QSLauncher.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Base.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />

            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
                <views:DownloadsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                <views:TasksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
                <views:VersionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModpacksViewModel}">
                <views:ModpacksView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModsViewModel}">
                <views:ModsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:JavaViewModel}">
                <views:JavaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
                <views:ResourcesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
                <views:AccountView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
